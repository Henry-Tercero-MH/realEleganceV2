node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# `tsc -b` a veces emite .js/.js.map sueltos junto a los .ts/.tsx fuente en
# vez de solo a dist/ (ver memoria del proyecto: "Build tooling gotcha").
# Estos directorios son TypeScript puro: cualquier .js aquí es un artefacto.
apps/web/src/**/*.js
apps/web/src/**/*.js.map
packages/shared/src/**/*.js
packages/shared/src/**/*.js.map

# `tsconfig.node.json` incluye `vite.config.ts` sin outDir propio, así que
# también puede emitir `vite.config.js(.map)` junto al `.ts` en la raíz de
# apps/web (no solo dentro de src/). Volvió a colarse una vez, ver commit
# 5b89d97 vs ef9338d: el patrón de arriba no cubría esta ruta.
apps/web/vite.config.js
apps/web/vite.config.js.map

.env
.env.local
.env.*.local
!.env.example

npm-debug.log*
yarn-error.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Volúmenes locales de docker-compose (si se montan como bind mounts)
.docker-data/
