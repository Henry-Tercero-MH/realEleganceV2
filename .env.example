# ─────────────────────────────────────────────────────────────
# Real Elegance — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` al repositorio.
# ─────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Guatemala

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Peticiones por ventana de rate limit (por IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=real_elegance
POSTGRES_USER=real_elegance
POSTGRES_PASSWORD=cambia_esta_password
# Puerto expuesto en la máquina anfitriona (docker-compose).
POSTGRES_HOST_PORT=5433
DATABASE_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ──────────────────────────────────────────────────────
# Genera secretos con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia_este_secreto_de_access_muy_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_muy_largo_y_aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ── Almacenamiento de imágenes (S3 / MinIO) ──────────────────
S3_ENDPOINT=http://minio:9000
# URL pública con la que el navegador descarga los objetos.
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=real-elegance-media
S3_ACCESS_KEY=real_elegance_minio
S3_SECRET_KEY=cambia_esta_password_minio
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_FILE_BYTES=5242880

# ── Reglas de negocio ────────────────────────────────────────
# Porcentaje de anticipo exigido para trajes a medida (0-1).
DEPOSIT_RATE=0.5
# Tasa de impuesto aplicada al subtotal (0-1).
TAX_RATE=0.12

# ── Seeds de demo ────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@realelegance.com
SEED_ADMIN_PASSWORD=Admin!2026
SEED_TAILOR_PASSWORD=Sastre!2026
SEED_CUSTOMER_PASSWORD=Cliente!2026

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
WEB_PORT=8080

# Fase de diseño: los datos vienen de src/mocks (sin backend)
VITE_USE_MOCKS=true
VITE_MOCK_LATENCY=320
