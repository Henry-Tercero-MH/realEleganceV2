{
  "name": "real-elegance",
  "version": "1.0.0",
  "private": true,
  "description": "Real Elegance — plataforma de sastrería artesanal (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @real-elegance/shared && npm run build -w @real-elegance/api && npm run build -w @real-elegance/web",
    "build:shared": "npm run build -w @real-elegance/shared",
    "dev": "npm run build:shared && concurrently -n api,web -c magenta,cyan \"npm run dev -w @real-elegance/api\" \"npm run dev -w @real-elegance/web\"",
    "dev:api": "npm run dev -w @real-elegance/api",
    "dev:web": "npm run dev -w @real-elegance/web",
    "test": "npm run test -w @real-elegance/shared && npm run test -w @real-elegance/api && npm run test -w @real-elegance/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "db:migrate": "npm run db:migrate -w @real-elegance/api",
    "db:rollback": "npm run db:rollback -w @real-elegance/api",
    "db:sql": "npm run db:sql -w @real-elegance/api",
    "db:seed": "npm run db:seed -w @real-elegance/api",
    "db:setup": "npm run db:setup -w @real-elegance/api",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
